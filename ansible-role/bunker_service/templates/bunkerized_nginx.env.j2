# Bunkerweb Configuration — templated by Ansible

SERVER_NAME={{ bunker_service_server_name }}{{ ' ' ~ bunker_service_ntfy_server_name if bunker_service_ntfy_server_name else '' }}
WHITELIST_COUNTRY={{ bunker_service_whitelist_country }}
WHITELIST_IP={{ bunker_service_whitelist_ip }}
DNS_RESOLVERS={{ bunker_service_dns_resolvers }}
API_WHITELIST_IP={{ bunker_service_api_whitelist_ip }}

USE_BUNKERNET=no
USE_MODSECURITY={{ bunker_service_use_modsecurity }}
MODSECURITY_SEC_RULE_ENGINE={{ bunker_service_modsecurity_sec_rule_engine }}
LIMIT_REQ_RATE={{ bunker_service_limit_req_rate }}
AUTO_LETS_ENCRYPT={{ bunker_service_auto_lets_encrypt }}
EMAIL_LETS_ENCRYPT={{ bunker_service_letsencrypt_email }}
GENERATE_SELF_SIGNED_SSL={{ bunker_service_generate_self_signed_ssl }}
DISABLE_DEFAULT_SERVER=yes
LOG_LEVEL={{ bunker_service_log_level }}

MULTISITE=yes
SERVE_FILES=no
USE_CLIENT_CACHE=yes
USE_GZIP=yes
USE_REVERSE_PROXY=yes
# The location the proxy serves; without it no proxy_pass is generated.
REVERSE_PROXY_URL=/

{{ bunker_service_server_name }}_AUTO_LETS_ENCRYPT={{ bunker_service_auto_lets_encrypt }}
{{ bunker_service_server_name }}_GENERATE_SELF_SIGNED_SSL={{ bunker_service_generate_self_signed_ssl }}
{{ bunker_service_server_name }}_REVERSE_PROXY_HOST={{ bunker_service_nextcloud_upstream_url }}
{{ bunker_service_server_name }}_REVERSE_PROXY_WS=yes
{{ bunker_service_server_name }}_MAX_CLIENT_SIZE={{ bunker_service_max_client_size }}
{{ bunker_service_server_name }}_USE_CLIENT_CACHE=yes
{{ bunker_service_server_name }}_ALLOWED_METHODS=GET|POST|HEAD|COPY|DELETE|LOCK|MKCOL|MOVE|PROPFIND|PROPPATCH|PUT|UNLOCK|OPTIONS|REPORT|SEARCH
{{ bunker_service_server_name }}_X_FRAME_OPTIONS=SAMEORIGIN
{{ bunker_service_server_name }}_BAD_BEHAVIOR_STATUS_CODES={{ bunker_service_bad_behavior_status_codes }}
{{ bunker_service_server_name }}_MODSECURITY_CRS_PLUGINS={{ bunker_service_modsecurity_crs_plugins }}
{% for limit in bunker_service_limit_req_urls %}
{{ bunker_service_server_name }}_LIMIT_REQ_URL_{{ loop.index }}={{ limit.url }}
{{ bunker_service_server_name }}_LIMIT_REQ_RATE_{{ loop.index }}={{ limit.rate }}
{% endfor %}

{% if bunker_service_ntfy_server_name %}
{% set ntfy = bunker_service_ntfy_server_name %}
# ntfy serves its API and its web app from the root, so it needs a name of its
# own rather than a path on the Nextcloud site. Basic auth sits here and not in
# ntfy: the app sends the same header either way, and ntfy then needs no user
# database and no volume. Alertmanager posts inside the pod and never passes
# through here.
{{ ntfy }}_AUTO_LETS_ENCRYPT={{ bunker_service_auto_lets_encrypt }}
{{ ntfy }}_GENERATE_SELF_SIGNED_SSL={{ bunker_service_generate_self_signed_ssl }}
{{ ntfy }}_REVERSE_PROXY_HOST={{ bunker_service_ntfy_upstream_url }}
{{ ntfy }}_REVERSE_PROXY_WS=yes
{{ ntfy }}_USE_AUTH_BASIC=yes
{{ ntfy }}_AUTH_BASIC_LOCATION=sitewide
{{ ntfy }}_AUTH_BASIC_USER={{ bunker_service_ntfy_auth_user }}
{{ ntfy }}_AUTH_BASIC_PASSWORD={{ bunker_service_ntfy_auth_password }}
{{ ntfy }}_ALLOWED_METHODS=GET|POST|HEAD|PUT|OPTIONS
{{ ntfy }}_MAX_CLIENT_SIZE=10M
# 401 is left out on purpose. Basic auth answers 401 before the phone sends
# its credentials, and the default list would ban the phone for it.
{{ ntfy }}_BAD_BEHAVIOR_STATUS_CODES=400 403 405 444
{% endif %}
