[Unit]
Requires=bunker-scheduler.service
After=bunker-scheduler.service

[Container]
Image={{ bunker_service_nginx_image }}
ContainerName=bunker-nginx
Pod=proxy.pod
EnvironmentFile=./configs/bunkerized_nginx.env
PodmanArgs={{ bunker_service_nginx_extra_args }}
# No HealthOnFailure here: podman rejects it unless the quadlet also sets
# HealthCmd, and bunkerweb's own HEALTHCHECK does not satisfy that.
